---
import { Image } from "astro:assets";
import hackbotsLogo from "../../assets/hackbots_logo.jpg";
import { nav, routes, team, withBase } from "../data/site.ts";

const base = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const pinnedHrefs = new Set<string>([routes.home, routes.donate]);
const pinned = nav.filter((item) => pinnedHrefs.has(item.href));
const collapsed = nav.filter((item) => !pinnedHrefs.has(item.href));

function isCurrent(href: string): boolean {
  const full = withBase(base, href).replace(/\/$/, "") || "/";
  if (href === "/") return pathname === full;
  return pathname === full || pathname.startsWith(`${full}/`);
}
---

<header class="site-header">
  <input class="nav-check" id="nav-toggle" type="checkbox" aria-controls="site-menu" />
  <label class="nav-toggle" for="nav-toggle">
    <svg class="nav-toggle-icon" width="22" height="22" viewBox="0 0 22 22" aria-hidden="true">
      <path class="nav-toggle-bars" d="M3 6h16M3 11h16M3 16h16" />
      <path class="nav-toggle-close" d="M6 6l10 10M16 6L6 16" />
    </svg>
    <span class="sr-only">Menu</span>
  </label>
  <a class="wordmark" href={withBase(base, "/")}>
    <Image class="wordmark-logo" src={hackbotsLogo} alt={`${team.name} ${team.number}`} />
  </a>
  <nav class="nav" aria-label="Primary">
    <div class="nav-pinned">
      {
        pinned.map((item) => (
          <a href={withBase(base, item.href)} aria-current={isCurrent(item.href) ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
    </div>
    <div class="nav-menu" id="site-menu">
      {
        collapsed.map((item) => (
          <a href={withBase(base, item.href)} aria-current={isCurrent(item.href) ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<script>
  const box = document.querySelector(".nav-check");
  const toggle = document.querySelector(".nav-toggle");
  const menu = document.querySelector(".nav-menu");
  const mobileNav = window.matchMedia("(max-width: 720px)");

  function closeMenu() {
    if (box instanceof HTMLInputElement) box.checked = false;
  }

  document.addEventListener("click", (event) => {
    if (!(box instanceof HTMLInputElement) || !box.checked) return;
    if (!(event.target instanceof Node)) return;
    if (event.target === box) return;
    if (toggle instanceof Node && toggle.contains(event.target)) return;
    if (menu instanceof Node && menu.contains(event.target)) return;
    closeMenu();
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || !(box instanceof HTMLInputElement) || !box.checked) return;
    closeMenu();
    if (box instanceof HTMLElement) box.focus();
  });

  mobileNav.addEventListener("change", () => {
    if (!mobileNav.matches) closeMenu();
  });
</script>
