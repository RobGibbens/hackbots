---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { formatLongDate } from "../data/calendar.ts";

interface Props {
  title: string;
  date: string;
  summary: string;
  heading: "h2" | "h3";
  href: string;
  image?: ImageMetadata;
  imageAlt?: string;
}

const { title, date, summary, heading: Heading, href, image, imageAlt } = Astro.props;
const hasImage = Boolean(image && imageAlt);
---

<a class="news-item" href={href}>
  <div class:list={["news-thumb", { "news-thumb-image": hasImage }]} aria-hidden={hasImage ? undefined : "true"}>
  {
    hasImage && image && imageAlt ? (
      <Image
        src={image}
        alt={imageAlt}
        widths={[150, 300]}
        sizes="(max-width: 640px) 9.4rem, 16rem"
        format="webp"
        quality={75}
      />
    ) : null
  }
  </div>
  <div>
    <p class="story-date">{formatLongDate(date)}</p>
    <Heading>{title}</Heading>
    <p>{summary}</p>
  </div>
</a>