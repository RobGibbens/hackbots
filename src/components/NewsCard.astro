---
import { formatLongDate } from "../data/calendar.ts";

interface Props {
  title: string;
  date: string;
  summary: string;
  heading: "h2" | "h3";
  href: string;
}

const { title, date, summary, heading: Heading, href } = Astro.props;
---

<a class="news-item" href={href}>
  <div class="news-thumb" aria-hidden="true"></div>
  <div>
    <p class="story-date">{formatLongDate(date)}</p>
    <Heading>{title}</Heading>
    <p>{summary}</p>
  </div>
</a>
