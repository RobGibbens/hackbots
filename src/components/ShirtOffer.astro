---
import { currentSeason, donation, routes, shirtOffer, shirtOfferIsOpen, withBase } from "../data/site.ts";

interface Props {
  showSponsorsLink?: boolean;
}

const { showSponsorsLink = true } = Astro.props;
const open = shirtOfferIsOpen(new Date());
const sponsors = withBase(import.meta.env.BASE_URL, routes.sponsors);
---

<section class="shirt-offer" data-shirt-offer="open" hidden={!open}>
  <h2>{currentSeason.year} team shirt donations</h2>
  <p>
    Hackbot families can add one line to the back of this season's team shirt for ${shirtOffer.amountUsd}.
    If your donation arrives on or before {shirtOffer.deadlineLabel}, your line goes on the shirt. The next day, we close the offer.
  </p>
  <p>
    We appreciate gift cards to <a href="https://wcproducts.com/products/westcoast-products-gift-card">West Coast Products</a>, <a href="https://store.ctr-electronics.com/products/gift-cards">CTR Electronics</a>, or <a href="https://www.thethriftybot.com/products/the-thrifty-bot-gift-card">Thrifty Bot</a>, or donate through the <a href={donation.url}> {donation.payableTo}</a>. In the donation memo, be sure to write "{donation.memo}" (or we won't get it!).
    {
      showSponsorsLink && (
        <>
          {" "}
          Sponsor tiers stay on <a href={sponsors}>Sponsors</a>.
        </>
      )
    }
  </p>
</section>
