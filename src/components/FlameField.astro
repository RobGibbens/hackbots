---
type Rand = () => number;

type FlameLayer = {
  fill: string;
  seed: number;
  /** Flames across the banner. */
  count: number;
  /** Valley line, as a fraction of the banner height. May sit past the bottom. */
  valley: number;
  /** Tallest tip, as a fraction of the banner height from the top. */
  peak: number;
  /** How much tip height varies within the row. */
  jitter: number;
  /** Horizontal shift, as a fraction of one flame. */
  phase: number;
  /** 0 keeps the sides steep. 1 rounds the belly. */
  belly: number;
  /** 0 is a round hill. 1 is a pointed tongue. */
  point: number;
};

const viewWidth = 2400;
const viewHeight = 420;
const base = viewHeight;

/**
 * Stacked rows of flame tongues. Light tips sit behind deeper purple,
 * and each row is shifted so its peaks fall into the valleys behind it.
 */
const layers: FlameLayer[] = [
  { fill: "#f3eef6", seed: 4, count: 18, valley: 0.44, peak: 0.02, jitter: 0.3, phase: 0.0, belly: 0.5, point: 0.42 },
  { fill: "#e4daec", seed: 12, count: 16, valley: 0.56, peak: 0.14, jitter: 0.22, phase: 0.48, belly: 0.56, point: 0.34 },
  { fill: "#cdb8e0", seed: 20, count: 14, valley: 0.68, peak: 0.26, jitter: 0.18, phase: 0.16, belly: 0.62, point: 0.26 },
  { fill: "#b08ccc", seed: 28, count: 12, valley: 0.8, peak: 0.38, jitter: 0.16, phase: 0.58, belly: 0.68, point: 0.2 },
  { fill: "#8d5eb0", seed: 36, count: 11, valley: 0.94, peak: 0.5, jitter: 0.14, phase: 0.08, belly: 0.74, point: 0.14 },
  { fill: "#6c3f99", seed: 44, count: 10, valley: 1.1, peak: 0.64, jitter: 0.12, phase: 0.46, belly: 0.8, point: 0.1 },
];

function mulberry32(seed: number): Rand {
  let state = seed >>> 0;
  return () => {
    state = (state + 0x6d2b79f5) | 0;
    let t = Math.imul(state ^ (state >>> 15), 1 | state);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

function n(value: number): string {
  return value.toFixed(1);
}

function curve(x1: number, y1: number, x2: number, y2: number, x: number, y: number): string {
  return ` C ${n(x1)} ${n(y1)}, ${n(x2)} ${n(y2)}, ${n(x)} ${n(y)}`;
}

function flameLayer(layer: FlameLayer): string {
  const rand = mulberry32(layer.seed);
  const spacing = viewWidth / layer.count;
  const valleyY = layer.valley * base;
  const maxRise = (layer.valley - layer.peak) * base;
  let x = -spacing * (1.25 + layer.phase);
  let d = `M ${n(x)} ${n(base + 40)} L ${n(x)} ${n(valleyY)}`;

  while (x < viewWidth + spacing) {
    const rise = maxRise * (1 - layer.jitter * 0.5 + rand() * layer.jitter);
    const half = spacing * 0.5;
    const tipX = x + half + (rand() - 0.5) * spacing * 0.06;
    const tipY = valleyY - rise;
    const nextX = x + spacing;
    const spanL = Math.max(8, tipX - x);
    const spanR = Math.max(8, nextX - tipX);
    // Steep sides, a bowed belly, and a tip that tapers as `point` increases.
    const wall = 0.5 + layer.point * 0.28;
    const shoulder = 0.06 + layer.point * 0.2;
    const bow = 0.46 - layer.point * 0.24 + layer.belly * 0.08;

    d += curve(
      x + spanL * (0.2 - layer.point * 0.06),
      valleyY - rise * wall,
      tipX - spanL * bow,
      tipY + rise * shoulder,
      tipX,
      tipY,
    );
    d += curve(
      tipX + spanR * bow,
      tipY + rise * shoulder,
      nextX - spanR * (0.2 - layer.point * 0.06),
      valleyY - rise * wall,
      nextX,
      valleyY,
    );

    x = nextX;
  }

  d += ` L ${n(x)} ${n(base + 40)} Z`;
  return d;
}
---

<svg
  class="flame-field"
  viewBox={`0 0 ${viewWidth} ${viewHeight}`}
  preserveAspectRatio="xMidYMax slice"
  aria-hidden="true"
>
  <rect width={viewWidth} height={viewHeight} fill="#f7f7f9"></rect>
  {layers.map((layer) => <path fill={layer.fill} d={flameLayer(layer)}></path>)}
</svg>
