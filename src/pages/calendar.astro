---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import eventsPhoto from "../../assets/events.jpg";
import "../styles/home.css";
import "../styles/events.css";
import EventCard from "../components/EventCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { calendarDayISO, compareIsoDate, isUpcoming } from "../data/calendar.ts";
import { routes, team, withBase } from "../data/site.ts";

const base = import.meta.env.BASE_URL;
const lede =
  "From our kickoff meeting, through build season and competitions, all the way to our year-end celebration, the Hackbots stay busy. Keep up with where we'll be, all season long.";
const events = (await getCollection("calendar"))
  .map((item) => ({ ...item.data, id: item.id, when: calendarDayISO(item.data.when) }))
  .filter((item) => isUpcoming(item.when))
  .sort((left, right) => compareIsoDate(left.when, right.when));
---

<BaseLayout
  title="Calendar"
  variant="visual"
  description={lede}
>
  <section class="hero page-hero events-hero">
    <div class="hero-media" aria-hidden="true">
      <Image
        src={eventsPhoto}
        alt=""
        class="events-hero-image"
        widths={[960, 1440, 1920]}
        sizes="min(70rem, calc(100vw - 2.5rem))"
        format="webp"
        quality={75}
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="wrap">
      <p class="eyebrow">{team.number}</p>
      <h1>Calendar</h1>
      <hr class="hero-rule" />
      <p class="lede">{lede}</p>
    </div>
  </section>

  <div class="events-main">
    <div class="wrap">
      <div class="event-list">
        {
          events.length === 0 ? (
            <p>No upcoming Events.</p>
          ) : (
            events.map((item) => (
              <EventCard
                title={item.title}
                when={item.when}
                where={item.where}
                heading="h2"
                href={withBase(base, `${routes.calendar}/${item.id}`)}
              />
            ))
          )
        }
      </div>
      <div class="calendar-embed">
        <iframe
          src="https://calendar.google.com/calendar/embed?height=600&wkst=1&bgcolor=%23ffffff&ctz=America%2FNew_York&src=dGVhbTM0MTRoYWNrYm90c0BnbWFpbC5jb20&color=%23D81B60"
          title="Hackbots Google Calendar"
          loading="lazy"
        ></iframe>
      </div>
    </div>
  </div>
</BaseLayout>
