---
import { getCollection } from "astro:content";
import "../styles/home.css";
import "../styles/events.css";
import EventCard from "../components/EventCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { calendarDayISO, compareIsoDate, isUpcoming } from "../data/calendar.ts";
import { routes, team, withBase } from "../data/site.ts";

const base = import.meta.env.BASE_URL;
const events = (await getCollection("events"))
  .map((item) => ({ ...item.data, id: item.id, when: calendarDayISO(item.data.when) }))
  .filter((item) => isUpcoming(item.when))
  .sort((left, right) => compareIsoDate(left.when, right.when));
---

<BaseLayout
  title="Events"
  variant="visual"
  description="This page lists upcoming Events only."
>
  <section class="hero page-hero">
    <div class="wrap">
      <p class="eyebrow">Team {team.number}</p>
      <h1>Events</h1>
      <hr class="hero-rule" />
      <p class="lede">This page lists upcoming Events only.</p>
    </div>
  </section>

  <div class="events-main">
    <div class="wrap">
      <div class="event-list">
        {
          events.length === 0 ? (
            <p>No upcoming Events.</p>
          ) : (
            events.map((item) => (
              <EventCard
                title={item.title}
                when={item.when}
                where={item.where}
                heading="h2"
                href={withBase(base, `${routes.events}/${item.id}`)}
              />
            ))
          )
        }
      </div>
    </div>
  </div>
</BaseLayout>
