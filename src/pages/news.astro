---
import { getCollection } from "astro:content";
import "../styles/home.css";
import "../styles/news.css";
import NewsCard from "../components/NewsCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { calendarDayISO, compareIsoDate } from "../data/calendar.ts";
import { routes, team, withBase } from "../data/site.ts";

const base = import.meta.env.BASE_URL;
const news = (await getCollection("news"))
  .map((item) => ({ ...item.data, id: item.id, date: calendarDayISO(item.data.date) }))
  .sort((left, right) => compareIsoDate(right.date, left.date));
---

<BaseLayout
  title="News"
  variant="visual"
  description="A News item is a dated story about the team."
>
  <section class="hero page-hero">
    <div class="wrap">
      <p class="eyebrow">{team.number}</p>
      <h1>News</h1>
      <hr class="hero-rule" />
      <p class="lede">A News item is a dated story about the team.</p>
    </div>
  </section>

  <div class="news-main">
    <div class="wrap">
      <div class="news-list">
        {
          news.length === 0 ? (
            <p>No News yet.</p>
          ) : (
            news.map((item) => (
              <NewsCard
                title={item.title}
                date={item.date}
                summary={item.summary}
                heading="h2"
                href={withBase(base, `${routes.news}/${item.id}`)}
              />
            ))
          )
        }
      </div>
    </div>
  </div>
</BaseLayout>
