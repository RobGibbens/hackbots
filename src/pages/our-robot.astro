---
import { Image } from "astro:assets";
import robotPhoto from "../../assets/ourrobot.png";
import "../styles/home.css";
import "../styles/our-robot.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import { currentSeason, routes, team, withBase } from "../data/site.ts";

const seasonHref = withBase(import.meta.env.BASE_URL, routes.currentSeason);
const lede = `The ${currentSeason.year} Robot is not built yet.`;
---

<BaseLayout title="Our Robot" variant="visual" description={lede}>
  <section class="hero page-hero robot-hero">
    <div class="hero-media" aria-hidden="true">
      <Image
        src={robotPhoto}
        alt=""
        class="robot-hero-image"
        widths={[960, 1440, 1920]}
        sizes="min(70rem, calc(100vw - 2.5rem))"
        format="webp"
        quality={75}
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="wrap">
      <p class="eyebrow">Team {team.number}</p>
      <h1>Our Robot</h1>
      <hr class="hero-rule" />
      <p class="lede">{lede}</p>
    </div>
  </section>

  <div class="robot-main">
    <div class="wrap">
      <section class="robot-block">
        <div class="section-head">
          <h2><span class="mark-slash" aria-hidden="true">/</span> This year's Game</h2>
        </div>
        <p>
          The {currentSeason.year} Game is {currentSeason.gameName}, presented by {currentSeason.gamePresentedBy}.
          How it is played will be revealed at kickoff on {currentSeason.kickoffLabel}.
        </p>
      </section>

      <section class="robot-block">
        <p>
          Captains, Leads, results, and the shirt deadline are on the
          <a href={seasonHref}>{currentSeason.year} Season</a>.
        </p>
      </section>
    </div>
  </div>
</BaseLayout>
