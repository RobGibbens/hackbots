---
import BaseLayout from "../layouts/BaseLayout.astro";
import { currentSeason, groups, joinFormUrl, memberEligibility, routes, withBase } from "../data/site.ts";

const seasonHref = withBase(import.meta.env.BASE_URL, routes.currentSeason);
---

<BaseLayout title="About">
  <h1>About</h1>
  <p class="lede">We are FIRST Robotics Competition Team 3414, the Hackbots.</p>

  <section>
    <h2>Who can join</h2>
    <p>{memberEligibility}</p>
    <p><a href={joinFormUrl}>Join the team</a></p>
  </section>

  <section>
    <h2>Our mission</h2>
    <article class="placeholder">
      <p class="placeholder-label">Placeholder</p>
      <p>The team mission will go here once someone has checked the wording. This sentence is not that mission.</p>
    </article>
  </section>

  <section>
    <h2>What FIRST is</h2>
    <p>
      FIRST is the nonprofit that runs the FIRST Robotics Competition. Each year, high-school teams receive a new
      Game. Students design, build, and program a Robot to play it, with Mentors working beside them.
    </p>
  </section>

  <section>
    <h2>What students gain</h2>
    <p>
      Members practice engineering, teamwork, and leadership. They compete, help the team find support, and teach
      younger students through Outreach.
    </p>
  </section>

  <section>
    <h2>Groups</h2>
    <p>Members work in one or more of these Groups. A Group is part of the Hackbots, not its own team.</p>
    <ul>
      {groups.map((group) => <li>{group}</li>)}
    </ul>
  </section>

  <section>
    <h2>Mentors</h2>
    <article class="placeholder">
      <p class="placeholder-label">Placeholder</p>
      <p>Mentor names will go here. This list is not the real roster of Mentors.</p>
    </article>
  </section>

  <p>
    This year's Captains and Leads are on the <a href={seasonHref}>{currentSeason.year} Season</a>.
  </p>
</BaseLayout>
