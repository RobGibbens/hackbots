---
import { Image } from "astro:assets";
import outreachPhoto from "../../assets/outreach.png";
import rrrasocLogo from "../../assets/outreach/rrrasoc-logo.png";
import carbonFootprintPdf from "../../assets/reduce_your_carbon_footprint_2024.pdf";
import batteryGuidelinePdf from "../../assets/battery-terminal-protection_guideline.pdf";
import "../styles/home.css";
import "../styles/outreach.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import { team, withBase } from "../data/site.ts";

const base = import.meta.env.BASE_URL;

/** Dev asset URLs omit the site base; production URLs already include it. */
function localAsset(url: string) {
  const prefix = base.endsWith("/") ? base.slice(0, -1) : base;
  if (!prefix || url === prefix || url.startsWith(`${prefix}/`)) return url;
  return withBase(base, url);
}

const campaignLinks = [
  {
    href: localAsset(carbonFootprintPdf),
    label: "How to Reduce Your Carbon Footprint",
  },
  {
    href: localAsset(batteryGuidelinePdf),
    label: "How to Safely Dispose Batteries",
  },
];
---

<BaseLayout
  title="Impact"
  variant="visual"
  description="Impact is our work with younger students and the public: camps, tutoring, mentoring FTC and FLL teams, demos, and drives."
>
  <section class="hero page-hero outreach-hero">
    <div class="hero-media" aria-hidden="true">
      <Image
        src={outreachPhoto}
        alt=""
        class="outreach-hero-image"
        widths={[960, 1440, 1920]}
        sizes="min(70rem, calc(100vw - 2.5rem))"
        format="webp"
        quality={75}
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="wrap">
      <p class="eyebrow">{team.number}</p>
      <h1>Impact</h1>
      <hr class="hero-rule" />
      <p class="lede">
        Impact is our work with younger students and the public: camps, tutoring, mentoring FTC and FLL teams, demos,
        and drives.
      </p>
    </div>
  </section>

  <div class="outreach-main">
    <div class="wrap">
      <section class="outreach-block">
        <div class="section-head">
          <h2><span class="mark-slash" aria-hidden="true">/</span> 2026 Impact Award</h2>
        </div>
        <p>
          The FIRST Impact Award is the highest honor in FIRST Robotics Competition. It recognizes the team other programs
          can look to: one that shows what FIRST is for, raising regard for science and technology and bringing more
          young people into those fields as leaders. Teams may send a video with their submission, and that video plays
          at the event if they win.
        </p>
        <p>
          Learn more about the <a href="https://www.firstinspires.org/resources/library/frc/fia-resources">FIRST's Impact Award</a>.
        </p>
        <div class="impact-video">
          <iframe
            src="https://www.youtube-nocookie.com/embed/UIgGcmrAeeA"
            title="Hackbots 2026 FIRST Impact Award video"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen></iframe>
        </div>
      </section>

      <section class="outreach-block">
        <div class="section-head">
          <h2><span class="mark-slash" aria-hidden="true">/</span> STEM is for Everyone</h2>
        </div>
        <p>
          Introduced in 2025, this campaign advocates for equal opportunities in STEM for all groups. Through outreach
          such as our robocamps, Tech Girls, and tutoring with the Farmington African American Parent Network, Hackbots
          strive to ensure everyone is empowered to build a future in STEM.
        </p>
        <div class="mission-panel">
          <h3>Mission Statement</h3>
          <p>
            To promote equal opportunity and inclusion of underrepresented groups in STEM, shaping a team that reflects
            our community and empowers all students to get involved in STEM.
          </p>
        </div>
      </section>

      <section class="outreach-block">
        <div class="section-head">
          <h2><span class="mark-slash" aria-hidden="true">/</span> Purple is the New Green</h2>
        </div>
        <p>
          Welcome to Hackbots' campaign <em class="campaign-name"><span class="campaign-purple">Purple</span> is the New <span class="campaign-green">Green</span></em>!
          This is all about reducing our carbon footprint for the Earth's survival.
        </p>
        <p>
          Purple is the New Green was first introduced in 2013, a project that has been continuing for the past 12 years
          to promote environmental safety and care in our community. We focus on using STEM to reduce carbon footprint,
          plastic pollution, and more so that upcoming generations have as much of an opportunity to thrive as us.
        </p>

        <div class="partner-panel">
          <div>
            <h3>Our Partner</h3>
            <p>
              Hackbots are proud to partner with Resource Recovery and Recycling Authority of Southwest Oakland County
              (RRRASOC) to reduce waste in our community. RRRASOC specializes in recycling items that usually get
              discarded. Because of this, Hackbots are able to host annual battery drives, bringing in old batteries to
              be safely disposed across the Farmington/Farmington Hills area. Since our partnership began, we have been
              able to safely dispose of over 1220+ pounds of batteries. We are excited to continue our partnership to
              reduce waste in our community.
            </p>
          </div>
          <Image
            src={rrrasocLogo}
            alt="RRRASOC, Resource Recovery and Recycling Authority of Southwest Oakland County"
            class="partner-logo"
            widths={[240, 480]}
            sizes="14rem"
            format="webp"
          />
        </div>

        <div class="campaign-actions">
          {
            campaignLinks.map((link) => (
              <a class="campaign-action" href={link.href} target="_blank" rel="noopener noreferrer">
                {link.label}
              </a>
            ))
          }
        </div>
      </section>

      <section class="outreach-block">
        <div class="section-head">
          <h2><span class="mark-slash" aria-hidden="true">/</span> Battery Drive</h2>
        </div>
        <p>Details coming soon.</p>
      </section>

      <section class="outreach-block">
        <div class="section-head">
          <h2><span class="mark-slash" aria-hidden="true">/</span> RoboCamps</h2>
        </div>
        <p>Details coming soon.</p>
      </section>
    </div>
  </div>
</BaseLayout>