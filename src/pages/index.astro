---
import { Image } from "astro:assets";
import "../styles/home.css";
import ShirtOffer from "../components/ShirtOffer.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import EventCard from "../components/EventCard.astro";
import NewsCard from "../components/NewsCard.astro";
import { calendarDayISO, compareIsoDate, isUpcoming } from "../data/calendar.ts";
import { heroTiming } from "../data/hero.ts";
import { joinFormUrl, routes, team, withBase } from "../data/site.ts";

const latestNews = (await getCollection("news"))
  .map((item) => ({ ...item.data, date: calendarDayISO(item.data.date) }))
  .sort((left, right) => compareIsoDate(right.date, left.date))
  .slice(0, 3);
const upcomingEvents = (await getCollection("events"))
  .map((item) => ({ ...item.data, id: item.id, when: calendarDayISO(item.data.when) }))
  .filter((item) => isUpcoming(item.when))
  .sort((left, right) => compareIsoDate(left.when, right.when))
  .slice(0, 3);

const heroPhotos = Object.entries(
  import.meta.glob<ImageMetadata>("../../assets/hero/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}", {
    eager: true,
    import: "default",
  }),
)
  .sort(([left], [right]) => left.localeCompare(right, "en"))
  .map(([, src]) => src);
const hero = heroTiming(heroPhotos.length);
const heroAlt = "Hackbots team photo";
const heroCrossfade = hero.animate
  ? `@keyframes hero-crossfade {
  0% { opacity: 0; }
  ${hero.fade}% { opacity: 1; }
  ${hero.hold}% { opacity: 1; }
  ${hero.out}% { opacity: 0; }
  100% { opacity: 0; }
}`
  : "";

const base = import.meta.env.BASE_URL;
const sponsors = withBase(base, routes.sponsors);
const crowd = Array.from({ length: 16 }, (_, index) => ({
  x: 36 + index * 78,
  y: 78 + (index % 2) * 16,
  r: 15 + (index % 3) * 3,
}));
---

<BaseLayout
  title="Home"
  variant="visual"
  description="Our high school robotics team is a community of curious minds, creative problem solvers, and passionate FIRST competitors."
>
  <section class="hero hero-home">
    {hero.animate && <style is:inline set:html={heroCrossfade} />}
    <div class="hero-media">
      {
        heroPhotos.map((src, index) => (
          <Image
            src={src}
            alt={heroAlt}
            class:list={["hero-slide", { "is-still": !hero.animate }]}
            style={
              hero.animate
                ? `animation-duration: ${hero.duration}s; animation-delay: ${hero.delays[index]}s`
                : undefined
            }
            widths={[960, 1440, 1920]}
            sizes="min(70rem, calc(100vw - 2.5rem))"
            format="webp"
            quality={75}
            loading="eager"
            decoding={index === 0 ? "sync" : "async"}
            fetchpriority={index === 0 ? "high" : "low"}
          />
        ))
      }
    </div>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Team {team.number}</p>
        <h1>{team.name}</h1>
        <p class="tagline">Build. Learn. Compete.<br />Together.</p>
        <hr class="hero-rule" />
        <p class="lede">
          Our high school robotics team is a community of curious minds, creative problem solvers, and passionate
          FIRST competitors.
        </p>
        <div class="actions">
          <a class="button primary" href={joinFormUrl}>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M16 19v-1a3 3 0 0 0-3-3H7a3 3 0 0 0-3 3v1" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
              <circle cx="10" cy="8" r="3" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
              <path d="M20 19v-1a3 3 0 0 0-2.2-2.9M16 5.1a3 3 0 0 1 0 5.8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
            </svg>
            Join Our Team →
          </a>
          <a class="button" href={sponsors}>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 19s-7-4.4-7-8.5A3.5 3.5 0 0 1 12 8a3.5 3.5 0 0 1 7 2.5C19 14.6 12 19 12 19z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
            </svg>
            Support Us →
          </a>
        </div>
      </div>
    </div>
    {
      hero.animate && (
        <>
          <input id="hero-pause" class="hero-pause" type="checkbox" />
          <label class="hero-toggle" for="hero-pause">
            <svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M8 5v14M16 5v14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
            </svg>
            <svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M9 6.5v11l9-5.5-9-5.5z" fill="currentColor"></path>
            </svg>
            <span class="hero-toggle-text">
              <span class="when-playing">Pause photos</span>
              <span class="when-paused">Play photos</span>
            </span>
          </label>
        </>
      )
    }
  </section>

  <section class="pillars" aria-label="Ways to take part">
    <div class="wrap pillars-grid">
      <a class="pillar" href={joinFormUrl}>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M16 19v-1a3 3 0 0 0-3-3H7a3 3 0 0 0-3 3v1" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
          <circle cx="10" cy="8" r="3" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
          <path d="M20 19v-1a3 3 0 0 0-2.2-2.9M16 5.1a3 3 0 0 1 0 5.8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
        </svg>
        <h2>Join the Team</h2>
        <p>Students, parents, and mentors — all are welcome!</p>
      </a>
      <a class="pillar" href={sponsors}>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="m11 17 2 2a1 1 0 1 0 3-3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
          <path d="m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
          <path d="m21 3 1 11h-2M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3M3 4h8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <h2>Support Our Team</h2>
        <p>Help us build, compete, and inspire.</p>
      </a>
      <a class="pillar" href={withBase(base, routes.outreach)}>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M8 4h8v5a4 4 0 0 1-8 0V4z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
          <path d="M8 6H5.5A2.5 2.5 0 0 0 8 10.2M16 6h2.5A2.5 2.5 0 0 1 16 10.2M12 13v2.5M9.5 20h5M10 15.5h4V20h-4z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <h2>Be Part of Something Bigger</h2>
        <p>STEM. Teamwork. Impact.</p>
      </a>
    </div>
  </section>

  <section class="digest" aria-label="News and events">
    <div class="wrap digest-grid">
      <div class="digest-col">
        <div class="section-head">
          <h2><span class="mark-slash" aria-hidden="true">/</span> Latest News</h2>
          <a href={withBase(base, routes.news)}>View All News →</a>
        </div>
        <div class="news-list">
          {
            latestNews.length === 0 ? (
              <p>No News yet.</p>
            ) : (
              latestNews.map((item) => (
                <NewsCard
                  title={item.title}
                  date={item.date}
                  summary={item.summary}
                  heading="h3"
                />
              ))
            )
          }
        </div>
      </div>
      <div class="digest-col">
        <div class="section-head">
          <h2><span class="mark-slash" aria-hidden="true">/</span> Upcoming Events</h2>
          <a href={withBase(base, routes.events)}>View All Events →</a>
        </div>
        <div class="event-list">
          {
            upcomingEvents.length === 0 ? (
              <p>No upcoming Events.</p>
            ) : (
              upcomingEvents.map((item) => (
                <EventCard
                  title={item.title}
                  when={item.when}
                  where={item.where}
                  heading="h3"
                  href={withBase(base, `${routes.events}/${item.id}`)}
                />
              ))
            )
          }
        </div>
      </div>
    </div>
  </section>

  <ShirtOffer />

  <section class="rally">
    <div class="rally-inner">
      <h2>Support the {team.name}</h2>
      <p class="rally-lead">Your generosity helps us build a brighter future — for our team and for STEM.</p>
      <p>Consider making a donation, becoming a sponsor, or volunteering your time and expertise.</p>
      <a class="button primary" href={sponsors}>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 19s-7-4.4-7-8.5A3.5 3.5 0 0 1 12 8a3.5 3.5 0 0 1 7 2.5C19 14.6 12 19 12 19z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
        </svg>
        Donate or Become a Sponsor →
      </a>
    </div>
    <svg class="crowd" viewBox="0 0 1240 210" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
      {
        crowd.map((person) => (
          <g fill="#2e1065">
            <circle cx={person.x} cy={person.y} r={person.r}></circle>
            <ellipse cx={person.x} cy={person.y + person.r + 26} rx={person.r + 16} ry={person.r + 10}></ellipse>
          </g>
        ))
      }
    </svg>
  </section>
</BaseLayout>
