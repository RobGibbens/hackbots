---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import seasonsPhoto from "../../../assets/seasons.jpg";
import "../../styles/home.css";
import "../../styles/seasons.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { currentSeason, routes, team, withBase } from "../../data/site.ts";

const base = import.meta.env.BASE_URL;

function seasonYear(id: string): number {
  const year = Number(id);
  return Number.isInteger(year) ? year : Number.NEGATIVE_INFINITY;
}

const seasons = (await getCollection("seasons"))
  .map((item) => ({ ...item.data, id: item.id }))
  .sort((left, right) => seasonYear(right.id) - seasonYear(left.id));

const earlierYears = seasons
  .map((item) => seasonYear(item.id))
  .filter((year) => year !== currentSeason.year && year > 0);
const lede =
  earlierYears.length === 0
    ? `We are preparing for the ${currentSeason.year} Season. Earlier Seasons are not listed yet.`
    : `We are preparing for the ${currentSeason.year} Season. Earlier Seasons run from ${Math.min(...earlierYears)} through ${Math.max(...earlierYears)}.`;
---

<BaseLayout title="Seasons" variant="visual" description={lede}>
  <section class="hero page-hero seasons-hero">
    <div class="hero-media" aria-hidden="true">
      <Image
        src={seasonsPhoto}
        alt=""
        class="seasons-hero-image"
        widths={[960, 1440, 1920]}
        sizes="min(70rem, calc(100vw - 2.5rem))"
        format="webp"
        quality={75}
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="wrap">
      <p class="eyebrow">{team.number}</p>
      <h1>Seasons</h1>
      <hr class="hero-rule" />
      <p class="lede">{lede}</p>
    </div>
  </section>

  <div class="seasons-main">
    <div class="wrap">
      <section class="seasons-block">
        <div class="section-head">
          <h2><span class="mark-slash" aria-hidden="true">/</span> Our history</h2>
        </div>
        <article class="placeholder">
          <p class="placeholder-label">Placeholder</p>
          <p>
            A short summary of the whole run of the Hackbots will go here once someone has checked it. This paragraph is
            not that history.
          </p>
        </article>
      </section>

      <section class="seasons-block">
        <div class="section-head">
          <h2><span class="mark-slash" aria-hidden="true">/</span> Years</h2>
        </div>
        {
          seasons.length === 0 ? (
            <p>No Seasons yet.</p>
          ) : (
            <ul class="year-list">
              {seasons.map((item) => (
                <li>
                  <a class="year-card" href={withBase(base, `${routes.seasons}/${item.id}`)}>
                    <Image
                      src={item.image}
                      alt={item.imageAlt}
                      class="year-photo"
                      widths={[320, 640]}
                      sizes="(max-width: 640px) calc(100vw - 4.5rem), 9.5rem"
                      format="webp"
                      quality={75}
                    />
                    <span class="year-copy">
                      <h3 class="year-title">{item.title}</h3>
                      <span class="year-status">{item.subtitle}</span>
                      <span class="year-note">{item.description}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </section>
    </div>
  </div>
</BaseLayout>
